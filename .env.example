# MediScript local configuration — no API keys required.
# Copy to .env happens automatically; edit values here, not in code.

# ---------- Speech recognition (local Whisper, loaded once at backend start) ----------
# English consultations: small.en (default). For non-English speech: small
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---------- Local LLM (Ollama, OpenAI-compatible endpoint) ----------
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:3b
# Optional. Only needed if a client library insists on a value; local Ollama ignores it.
LLM_API_KEY=local

# ---------- Ports ----------
BACKEND_PORT=8000
FRONTEND_PORT=5173
